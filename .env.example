QWEN_MODEL=Qwen/Qwen3.5-2B
QWEN_DEVICE=cuda
QWEN_QUANTIZATION=4bit
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DEVICE=cpu
VOC_PATH=data/voc_dummy_2500_v3_해설판.xlsx
ROUTING_MASTER_PATH=data/korail_voc_routing_master.xlsx
OUTPUT_PATH=outputs
TOP_K=10
TOP_N=3
MIN_SIMILARITY=0.55
MIN_SUPPORT=2
MIN_SCORE_MARGIN=0.03
SPLIT_MODE=holdout
HISTORY_FRACTION=0.8
STARTUP_MODELS=true
HOST=127.0.0.1
PORT=8001

# Offline VOC intelligence (CPU; experimental thresholds, not calibrated)
BER_TOPIC_MIN_CLUSTER_SIZE=5
BER_TOPIC_MIN_SAMPLES=2
BER_TOPIC_UMAP_NEIGHBORS=10
BER_TOPIC_UMAP_COMPONENTS=5
BER_TOPIC_UMAP_MIN_DIST=0.0
BER_TOPIC_RANDOM_SEED=42
BER_TOPIC_DOMINANT_LABEL_RATIO=0.8
BER_TOPIC_WARNING_THRESHOLD=0.1
BER_TOPIC_WARNING_MIN_CASES=5
BER_TOPIC_TREND_DAYS=30
BER_TOPIC_TREND_MIN_CASES=5
BER_TOPIC_TREND_GROWTH=0.5
BER_TOPIC_DATE_COLUMN=

# Short analysis-text retrieval comparison threshold; provisional, not a probability
ANALYSIS_MIN_SIMILARITY=0.35
